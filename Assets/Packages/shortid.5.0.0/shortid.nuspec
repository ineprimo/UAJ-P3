<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>shortid</id>
    <version>5.0.0</version>
    <title>ShortID</title>
    <authors>Winner-Timothy Bolorunduro</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <licenseUrl>https://github.com/bolorundurowb/shortid/blob/master/LICENSE</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/bolorundurowb/shortid/</projectUrl>
    <iconUrl>https://members.orcid.org/sites/default/files/vector_iD_icon.svg</iconUrl>
    <description>A library that generates random identifiers with a minimum length of 8 characters. Identifiers generated can be used as primary keys for databases or unique identifiers.</description>
    <releaseNotes>- add support for monotonic/sequential id generation
- move the generation options to the package root</releaseNotes>
    <copyright>© 2017-2026 , Bolorunduro Winner-Timothy. All Rights reserved.</copyright>
    <tags>shortid short id databse identifier key primarykey mongodb sql</tags>
    <repository type="git" url="https://github.com/bolorundurowb/shortid/" commit="652030cc2e96581e432c5938bf72b98381910795" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>